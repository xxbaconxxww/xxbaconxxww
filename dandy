local player = game.Players.LocalPlayer

for _,playerschar in workspace.InGamePlayers:GetChildren() do
	if  player.Name ~= playerschar.Name then
		local bg = Instance.new('BillboardGui',playerschar.HumanoidRootPart)
		bg.Size = UDim2.new(2,0,2,0)
		bg.AlwaysOnTop = true
		local tl = Instance.new('TextLabel',bg)
		tl.Size = UDim2.new(1,0,1,0)
		tl.BackgroundTransparency = 1
		tl.TextColor3 = Color3.new(1,1,1)
		tl.TextSize = 13
		tl.FontFace.Bold = true
		tl.TextScaled = true
		task.spawn(function()
			while true do
				local text = ''
				for _,item in playerschar.Inventory:GetChildren() do
					text = text..item.Value..' '
				end
				tl.Text = text
				wait(1)
			end
		end)
		
	end
end


function highlight(item)
	Instance.new('Highlight',item)
	local bg = Instance.new('BillboardGui',item)
	bg.Size = UDim2.new(1,0,1,0)
	bg.AlwaysOnTop = true
	local tl = Instance.new('TextLabel',bg)
	tl.Size = UDim2.new(1,0,1,0)
	tl.BackgroundTransparency = 1
	tl.TextSize = 8
	tl.FontFace.Bold = true
	tl.Text = item.Name
	if item.Name == 'Bandage' or item.Name == 'HealthKit' then
		tl.TextColor3 = Color3.new(1,0,0)
	else
		tl.TextColor3 = Color3.new(1,1,1)
	end
end


local a
function highlightall()
	local items = workspace.CurrentRoom:GetChildren()[1]:WaitForChild('Items')
	for _,item in items:GetChildren() do
		highlight(item)
	end
	a = items.ChildAdded:Connect(function(item)
		highlight(item)
	end)
end

workspace.CurrentRoom.ChildAdded:Connect(highlightall)

if workspace.CurrentRoom:GetChildren()[1] then
	highlightall()
end
